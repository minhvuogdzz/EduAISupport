# Copy to services/api/.env (gitignored) and fill in. Never commit real secrets.
# MongoDB Atlas connection string (Atlas -> Connect -> Drivers).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?appName=Cluster0
MONGODB_DB=cavat_dev

# Tutor brain: Qwen on Groq (ADR-017). Key from console.groq.com.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3

# Gemini: only vision/OCR (geometry images) and voice/live (ADR-017). Key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live

# LlamaCloud (LlamaParse) for parsing teacher PDF/PPTX documents.
LLAMA_CLOUD_API_KEY=

MAX_LLM_CALLS_PER_SESSION=15
# template = chỉ dùng câu mẫu đã duyệt (mặc định); llm = Qwen diễn đạt gợi ý, câu mẫu làm dự phòng
TUTOR_RENDERER=template

# WEB-1 (DI-51): a question the teacher's documents do not answer, "X là gì" only, may be looked up in
# Vietnamese Wikipedia (the only allowed source). off: such questions are kept for the teacher.
WEB_LOOKUP=wikipedia

# ADR-030 voice live: the tutor's voice from VieNeu-TTS running locally (make voice-setup, make voice).
# off, or the voice server not running: the browser reads with its own Vietnamese voice.
TTS=vieneu
VIENEU_URL=http://127.0.0.1:8010
VIENEU_VOICE=


# Accounts (ACC-1): one student, one parent, one teacher log in with a PIN. Create them with `make accounts`.
# accounts (default) | demo (X-Demo-* headers, only for the in-memory demo and the offline tests)
AUTH_MODE=accounts
# Key that signs login tokens; any long random string. Unset: a new key at each API start (log in again).
AUTH_SECRET=
# Optional, read by `make accounts` instead of asking (the PIN is 4 to 8 digits, never committed).
# ACCOUNT_STUDENT_NAME=Minh
# ACCOUNT_STUDENT_PIN=
# ACCOUNT_PARENT_NAME=
# ACCOUNT_PARENT_PIN=
# ACCOUNT_TEACHER_NAME=
# ACCOUNT_TEACHER_PIN=
