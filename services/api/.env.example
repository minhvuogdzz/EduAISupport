# Copy to services/api/.env (gitignored) and fill in. Never commit real secrets.
# MongoDB Atlas connection string (Atlas -> Connect -> Drivers).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?appName=Cluster0
MONGODB_DB=cavat_dev

# Tutor brain: Qwen on Groq (ADR-017). Key from console.groq.com.
# Reasoning is off (reasoning_effort "none") and each prompt stays <= 3.000 token (Groq: 8.000 token/minute).
# Qwen out of quota or down: openai/gpt-oss-120b (gpt-oss-20b for the light calls), then approved templates.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3
# Optional (CFG-3): a key of ANOTHER Groq project, for make eval-*, make simulate and make draft-teaching, so
# they do not spend the quota of the key the students use. Quota is per organization: set the project's own
# limit in console.groq.com (Limits), a second key of the same project changes nothing. Empty: GROQ_API_KEY.
GROQ_API_KEY_EVAL=

# Gemini: only vision/OCR (geometry images, scanned pages) and the Hybrid RAG vectors (ADR-017).
# Key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# DI-71 (REFORM-1): 40 lần gọi model mỗi buổi (trước là 15)
MAX_LLM_CALLS_PER_SESSION=40
# Whole-chapter sessions (several lessons), DI-90; provider quotas still apply.
MAX_LLM_CALLS_PER_CHAPTER=160
# DI-92: verified standard theory beyond retrieved passages, within the current curriculum.
ALLOW_TUTOR_KNOWLEDGE=true
# template = chỉ dùng câu mẫu đã duyệt; llm = Qwen diễn đạt, câu mẫu làm dự phòng.
# REFORM-1: để trống thì có GROQ_API_KEY là llm, không có là template.
# TUTOR_RENDERER=template
# AUTO-1 (ADR-031), chỉ có tác dụng khi TUTOR_RENDERER=llm: llm = Qwen chọn một trong các nước đi chính sách
# cho phép (mặc định); policy = luôn giữ nước của chính sách
TUTOR_CHOOSER=llm

# BRAIN-2: theory missing from the teacher's documents can use the following source.
# Official NXB Giáo dục publications, within the current lesson/prerequisites only (ADR-038).
# off disables lookup; wikipedia is the optional legacy adapter under the same scope gate.
WEB_LOOKUP=search
# Optional stable search provider; blank uses public search with limited reliability.
TAVILY_API_KEY=

# ADR-030 voice live: the tutor's voice from VieNeu-TTS running locally (make voice-setup, make voice).
# off, or the voice server not running: the browser reads with its own Vietnamese voice.
TTS=vieneu
VIENEU_URL=http://127.0.0.1:8010
VIENEU_VOICE=


# Accounts (ACC-1): one student, one parent, one teacher log in with a PIN. Create them with `make accounts`.
# accounts (default) | demo (X-Demo-* headers, only for the in-memory demo and the offline tests)
AUTH_MODE=accounts
# Key that signs login tokens; any long random string. Unset: a new key at each API start (log in again).
AUTH_SECRET=
# Optional, read by `make accounts` instead of asking (the PIN is 4 to 8 digits, never committed).
# ACCOUNT_STUDENT_NAME=Minh
# ACCOUNT_STUDENT_PIN=
# ACCOUNT_PARENT_NAME=
# ACCOUNT_PARENT_PIN=
# ACCOUNT_TEACHER_NAME=
# ACCOUNT_TEACHER_PIN=
