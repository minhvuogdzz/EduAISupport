# Copy to services/api/.env (gitignored) and fill in. Never commit real secrets.
# MongoDB Atlas connection string (Atlas -> Connect -> Drivers).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?appName=Cluster0
MONGODB_DB=cavat_dev

# Tutor brain: Qwen on Groq (ADR-017). Key from console.groq.com.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3

# Gemini: only vision/OCR (geometry images) and voice/live (ADR-017). Key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live

# LlamaCloud (LlamaParse) for parsing teacher PDF/PPTX documents.
LLAMA_CLOUD_API_KEY=

MAX_LLM_CALLS_PER_SESSION=15
