# Copy to services/api/.env (gitignored) and fill in. Never commit real secrets.
# MongoDB Atlas connection string (Atlas → Connect → Drivers).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?appName=Cluster0
MONGODB_DB=cavat_dev
# Gemini API key from Google AI Studio (free tier). Only needed for `make poc1-gemini`.
GEMINI_API_KEY=
TUTOR_MODEL=gemini-3.8-flash
LIGHTWEIGHT_MODEL=gemini-3.5-flash-lite
