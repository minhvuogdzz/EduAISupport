# What the image build does not see. Above all: no secret and no child's data ever goes into an image layer.
.git
.github
.claude
**/.env
**/.env.*
db-dump
var
tailieu
space
evals

# dependencies and builds are made inside the image
**/node_modules
**/.venv
**/dist
**/__pycache__
**/*.pyc
**/*.egg-info
**/.pytest_cache
**/.ruff_cache

# the images need only the lessons of docs/; tests are not run in them
docs/*
!docs/pedagogy
services/api/tests
.pnpm-store
