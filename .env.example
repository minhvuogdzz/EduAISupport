# Cấu hình của docker compose (deploy/README.md). Sao chép thành .env, không commit:
#   sh deploy/setup.sh      (tạo .env và điền sẵn hai giá trị ngẫu nhiên)
# Dòng bắt đầu bằng # là ghi chú. Không đặt dấu cách quanh dấu =.

# --- Bắt buộc ---
# Khóa Groq: model viết lời gia sư và nghe giọng nói (do chủ dự án đưa).
GROQ_API_KEY=
# Mật khẩu của MongoDB trong compose: chỉ chữ và số (setup.sh tự tạo). Đổi sau khi đã có dữ liệu thì Mongo từ chối.
MONGO_PASSWORD=
# Chuỗi ngẫu nhiên dài ký token đăng nhập (setup.sh tự tạo). Đổi thì mọi người phải đăng nhập lại.
AUTH_SECRET=

# --- Nên có ---
# Khóa Gemini: đọc ảnh và chữ trong ảnh, vector tìm trong tài liệu. Để trống thì các phần đó không chạy.
GEMINI_API_KEY=

# --- Tùy chọn ---
# Cổng ngoài của app (trong container luôn là 8000). Đặt 127.0.0.1:8080 để chỉ máy chủ này (hoặc HTTPS bên dưới) vào được.
PORT=8080
# Tên database trong Mongo của compose.
MONGODB_DB=cavat_prod
# Thứ tự model viết lời gia sư, cách nhau dấu phẩy. Để trống: thứ tự đã đo (gpt-oss-120b, gpt-oss-20b, Qwen). ADR-034.
TUTOR_MODELS=
# Trần lượt gọi model mỗi buổi (DI-71). Chạm trần thì dùng lời đã duyệt/câu mẫu.
MAX_LLM_CALLS_PER_SESSION=40
# Lý thuyết thiếu trong RAG: chỉ ấn phẩm chính thống trong phạm vi bài (ADR-038). off: tắt tra cứu ngoài.
WEB_LOOKUP=official
# Tên miền cho HTTPS tự động của Caddy: docker compose --profile https up -d (DNS phải trỏ về máy chủ, mở cổng 80 và 443).
DOMAIN=localhost
